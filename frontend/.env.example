# Browser-facing API base. Prefer /api so requests go through this Next server
# (works when the UI is opened via Tailscale/LAN, not only localhost).
NEXT_PUBLIC_API_URL=/api

# Server-side FastAPI origin for Next rewrites (no /api suffix).
# Change the port when you run a second backend instance, e.g. 8081.
BACKEND_URL=http://localhost:8080

# Optional: comma-separated hosts allowed for Next.js HMR over LAN/Tailscale.
# Example: ALLOWED_DEV_ORIGINS=100.x.y.z
# ALLOWED_DEV_ORIGINS=

# TODO: Remove NEXT_PUBLIC_USE_MOCK_DATA before final project delivery.
# Prefer `npm run dev -- --test` instead of setting this in .env.local.
# NEXT_PUBLIC_USE_MOCK_DATA=true
