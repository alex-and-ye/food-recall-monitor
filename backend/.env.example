# Copy to backend/.env and adjust as needed.

# ChromaDB HTTP client settings (used by the FastAPI backend).
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Filesystem path for the ChromaDB server data directory.
# Must match the --path argument when you run `chroma run`.
# Relative paths are resolved from backend/.
# CHROMA_SERVER_DATA_PATH=.chroma_data

# Brave Search credential. Required only when early warning is enabled in
# config/pipelines.yaml. Never put this value in a YAML file.
# BRAVE_API_KEY=
# BRAVE_SEARCH_BASE_URL=https://api.search.brave.com/res/v1/web/search

# Optional config path overrides (relative paths resolve from backend/).
# PIPELINE_SWITCHES_PATH=config/pipelines.yaml
# EARLY_WARNING_CONFIG_PATH=config/early_warning.yaml
